{
  "opencollection": "1.0.0",
  "info": {
    "name": "Scribe Search & Retrieval Documents Teams API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://public-api.scribehow.com/v1/teams/",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Return every team accessible to your API key. Use the returned `id` values as `team_ids` filters on the search and document endpoints."
        }
      ]
    }
  ],
  "bundled": true
}