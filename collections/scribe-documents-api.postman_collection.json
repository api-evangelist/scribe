        {
          "id": "9ba666eb-7291-4c1d-bfa3-ebfb8be6bd42",
          "name": "List documents",
          "request": {
            "name": "List documents",
            "description": {
              "content": "Paginated list of every document accessible to your API key, ordered by creation date (newest first). Supports filtering by type, team, and creation/update date ranges. The default page size is 100 and the maximum is 100; use the `limit` and `offset` query parameters to paginate.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "documents",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "created__gte",
                  "value": "<dateTime>",
                  "description": "Created at or after (ISO-8601)"
                },
                {
                  "disabled": false,
                  "key": "created__lte",
                  "value": "<dateTime>",
                  "description": "Created at or before (ISO-8601)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of results to return per page."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "The initial index from which to return the results."
                },
                {
                  "disabled": false,
                  "key": "team_ids",
                  "value": "<uuid>"
                },
                {
                  "disabled": false,
                  "key": "team_ids",
                  "value": "<uuid>"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Restrict results to a single document type.\n\n* `page` - Knowledge Page\n* `scribe` - Scribe Document"
                },
                {
                  "disabled": false,
                  "key": "updated__gte",
                  "value": "<dateTime>",
                  "description": "Last meaningful user edit at or after (ISO-8601). Targets a separate column from the response `updated_at` field, which is bumped on every save."
                },
                {
                  "disabled": false,
                  "key": "updated__lte",
                  "value": "<dateTime>",
                  "description": "Last meaningful user edit at or before (ISO-8601). Targets a separate column from the response `updated_at` field, which is bumped on every save."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
